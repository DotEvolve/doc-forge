{
  "name": "@dotevolve/doc-forge",
  "version": "0.1.3",
  "description": "DocForge: Pure declarative document and print rendering engine",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "dev:demo": "npm run dev --prefix demo",
    "build:demo": "npm run build --prefix demo",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contrib": {
      "types": "./dist/contrib/index.d.ts",
      "import": "./dist/contrib.js",
      "require": "./dist/contrib.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DotEvolve/doc-forge.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-to-print": ">=3.0.0"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
